classDiagram
    class Owner {
        +String name
        +String address
        +List~Pet~ pets
        +addOwnerInformation(name: String, address: String): void
        +addPetInformation(pet: Pet): void
        +getAllTasks(): List~Task~
    }

    class Pet {
        +String name
        +int age
        +String petType
        +String breed
        +List~Task~ tasks
        +addTask(task: Task): void
    }

    class Task {
        +String name
        +String description
        +int duration
        +int priority
        +Optional~time~ scheduledStart
        +String frequency
        +bool completed
        +createTask(name: String, description: String, duration: int, priority: int, scheduledStart: Optional~time~, frequency: String, completed: bool): Task
        +editTask(name: String, description: String, duration: int, priority: int): void
        +deleteTask(pet: Pet): void
    }

    class Scheduler {
        +Owner owner
        +List~Task~ dailySchedule
        +String reasoning
        +createDailySchedule(): List~Task~
        +markTaskCompleted(task: Task): void
        +provideReasoning(): String
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has care tasks
    Scheduler --> Owner : retrieves tasks from
    Scheduler --> "0..*" Task : schedules
