classDiagram
    class Owner {
        +String name
        +String address
        +List~Pet~ pets
        +addOwnerInformation(name: String, address: String): void
        +addPetInformation(pet: Pet): void
    }

    class Pet {
        +String name
        +int age
        +String petType
        +String breed
        +List~Task~ tasks
        +addTask(task: Task): void
    }

    class Task {
        +String name
        +String description
        +int duration
        +int priority
        +Optional~time~ scheduledStart
        +createTask(name: String, description: String, duration: int, priority: int): Task
        +editTask(name: String, description: String, duration: int, priority: int): void
        +deleteTask(pet: Pet): void
    }

    class Planner {
        +List~Task~ dailySchedule
        +List~String~ constraints
        +List~String~ priorities
        +String reasoning
        +createDailySchedule(): List~Task~
        +considerConstraints(): void
        +considerPriorities(): void
        +provideReasoning(): String
        +display(): void
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has care tasks
    Planner --> "0..*" Task : schedules
